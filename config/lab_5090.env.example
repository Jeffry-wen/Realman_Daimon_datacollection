# Required local dependency. Change this in config/lab_5090.env.
LEROBOT_ROOT=/absolute/path/to/compatible/lerobot
CONDA_ENV=lerobot51

# Process and UI. Loopback avoids exposing the unauthenticated capture UI.
OPENCV_NUM_THREADS=1
OPENCV_OPENCL=false
CAPTURE_UI_HOST=127.0.0.1
CAPTURE_UI_PORT=8766
CAPTURE_OPEN_BROWSER=true

# Dataset session.
TASK_INDEX=both
FPS=30
NUM_EPISODES=2000
EPISODE_TIME_S=12000
RUN_NAME_PREFIX=kd_tacmae_force_both
DATASET_BASE_DIR=dataset

# Optional D405 camera; parameters remain recorded even while disabled.
CONNECT_D405_CAMERA=false
D405_CAMERA_DEVICE=/dev/video4
D405_CAMERA_WIDTH=640
D405_CAMERA_HEIGHT=480
D405_CAMERA_FPS=30
D405_CAMERA_FOURCC=YUYV
D405_CAMERA_BACKEND=V4L2
D405_CAMERA_WARMUP_S=0

# Wrist RGB and video encoding.
CONNECT_WRIST_CAMERA=true
WRIST_CAM_WIDTH=1920
WRIST_CAM_HEIGHT=1080
WRIST_CAM_FPS=30
VCODEC=h264_nvenc
ENCODER_QUEUE_MAXSIZE=1500
ENCODER_THREADS=2
FISH_CAMERA_FFMPEG_THREADS=2
FISH_CAMERA_UDP_FIFO_SIZE=8000000
WRIST_UNDISTORT=true
WRIST_UNDISTORT_CROP_SIZE=896
WRIST_UNDISTORT_BALANCE=0.0
WRIST_PROCESSED_ASYNC_CACHE=true
WRIST_PROCESSED_ASYNC_CACHE_STATS_EVERY_S=0
WRIST_PROCESSED_ASYNC_CACHE_STARTUP_FRAMES=10
WRIST_PIPELINE_MODE=queued
WRIST_TIMESTAMP_MODE=frame_clock
WRIST_FRAME_CLOCK_FPS=30
WRIST_UNDISTORT_WORKERS_PER_CAMERA=4
WRIST_RAW_QUEUE_FRAMES=120
WRIST_PROCESSED_QUEUE_FRAMES=120
WRIST_PIPELINE_OVERFLOW_ACTION=abort
WRIST_SOURCE_LATENCY_FRAMES=5
WRIST_SOURCE_LATENCY_S=0.0

# Aligned sampling and fail-closed freshness checks.
ALIGNED_START_DELAY_S=0.5
ALIGNED_STARTUP_TIMEOUT_S=10
ALIGNED_STARTUP_MAX_AGE_MS=1000
ALIGNED_WRIST_READY_TIMEOUT_S=0.6
ALIGNED_STRICT_NO_HOLD=true
ALIGNED_HOLD_LAST_ON_STALE=false
ALIGNED_VISUAL_MAX_AGE_MS=120
ALIGNED_WRIST_MAX_AGE_MS=120
ALIGNED_WRIST_PREFERRED_MAX_OFFSET_MS=40
ALIGNED_D405_MAX_AGE_MS=200
ALIGNED_TACTILE_MAX_AGE_MS=250
ALIGNED_BUFFER_SECONDS=4
ALIGNED_STATE_BUFFER_SECONDS=12
ALIGNED_WRIST_BUFFER_SECONDS=12
ALIGNED_D405_BUFFER_SECONDS=6
ALIGNED_TACTILE_BUFFER_SECONDS=12
ALIGNED_WRITER_DELAY_S=0.45
ALIGNED_WRIST_POLL_HZ=120
ALIGNED_ABORT_ON_MISSING=true
ALIGNED_WRITER_QUEUE_MAXSIZE=240
ALIGNED_DATASET_SEAL_AFTER_SAVE=true
ALIGNED_DATASET_SNAPSHOT_AFTER_SAVE=true
ALIGNED_DATASET_SNAPSHOT_KEEP=2
ALIGNED_DATASET_RESTORE_ON_ERROR=true

# Encoder warm-up before an episode begins.
ALIGNED_PRESTART_STREAMING_ENCODERS=true
ALIGNED_ENCODER_WARM_START=true
ALIGNED_ENCODER_WARM_START_TIMEOUT_S=5.0
ALIGNED_CLEAR_BUFFERS_AFTER_ENCODER_PRESTART=true
ALIGNED_ENCODER_PRESTART_SETTLE_S=0.8
ALIGNED_POST_ENCODER_STARTUP_TIMEOUT_S=5.0
ALIGNED_POST_ENCODER_STABLE_S=0.6
ALIGNED_POST_ENCODER_MIN_UPDATES=3

# Foot pedal: start, finish/save, discard. The two-pedal software stop is
# disabled so each single-pedal command is dispatched immediately. Keep the
# safety-rated physical emergency-stop button accessible.
FOOT_PEDAL_CONTROL=true
FOOT_PEDAL_DEVICE=/dev/input/by-id/usb-PCsensor_FS20Pro-event-kbd
FOOT_PEDAL_GRAB=true
FOOT_PEDAL_START_KEY=KEY_A
FOOT_PEDAL_FINISH_KEY=KEY_B
FOOT_PEDAL_DISCARD_KEY=KEY_C
FOOT_PEDAL_DEBOUNCE_S=0.25
FOOT_PEDAL_RECONNECT_S=0.5
FOOT_PEDAL_TWO_PEDAL_STOP_ENABLED=false
FOOT_PEDAL_TWO_PEDAL_WINDOW_S=0.0

# X5 tactile acquisition.
CONNECT_X5_TACTILE=true
X5_TACTILE_ASYNC_CACHE=true
X5_TACTILE_ASYNC_CACHE_MODE=per_sensor_thread
X5_TACTILE_ASYNC_CACHE_FPS=120
X5_TACTILE_ASYNC_CACHE_HISTORY_SECONDS=12
ALIGNED_TACTILE_USE_CACHE_HISTORY=true
ALIGNED_TACTILE_HISTORY_BATCH=1024
ALIGNED_TACTILE_DEBUG_EVERY_S=0
TACTILE_RECONNECT_ON_EPISODE_START=auto
ALIGNED_TACTILE_MONITOR_DURING_EPISODE=false
ALIGNED_TACTILE_RECONNECT_ON_STALL=false
ALIGNED_TACTILE_RECONNECT_DURING_EPISODE=false
ALIGNED_TACTILE_STALL_TIMEOUT_S=2.0
X5_TACTILE_MAX_FPS=45
X5_TACTILE_MODE=standard
X5_TACTILE_FLUX_PC_HOST=192.168.1.100
X5_TACTILE_FLUX_LEFT_LEFT_PC_PORT=61000
X5_TACTILE_FLUX_LEFT_RIGHT_PC_PORT=61001
X5_TACTILE_FLUX_RIGHT_LEFT_PC_PORT=61002
X5_TACTILE_FLUX_RIGHT_RIGHT_PC_PORT=61003
TACTILE_STALE_MAX_REPEATS=3
TACTILE_STALE_MIN_ABORT_AGE_MS=500

# Preview only; this does not change saved tactile values.
RGB_PREVIEW=true
RGB_PREVIEW_FPS=5
RGB_PREVIEW_WIDTH=480
TACTILE_PREVIEW=true
TACTILE_PREVIEW_WIDTH=240
TACTILE_PREVIEW_RGB_PASSTHROUGH=true
ALIGNED_TACTILE_PREVIEW_DIRECT_RGB=true
TACTILE_PREVIEW_DEPTH_MODE=abs
TACTILE_PREVIEW_THRESHOLD_FILE=config/calibration/tactile_preview_thresholds.json
TACTILE_PREVIEW_USE_STARTUP_BASELINE=false
TACTILE_PREVIEW_THRESHOLD_SCALE=1.0
TACTILE_PREVIEW_ROTATE_CLOCKWISE=true
PREVIEW_WINDOW_SCALE=1.5
PREVIEW_FPS=15
RECORD_SYNC_DIAGNOSTICS=false

# Force sensors.
CONNECT_LEFT_FORCE_SENSOR=true
CONNECT_RIGHT_FORCE_SENSOR=true
FORCE_SENSOR_REQUIRED=true
FORCE_SENSOR_DATA_KEY=work_zero_force_data
FORCE_SENSOR_CLEAR_ON_CONNECT=true
FORCE_SENSOR_CLEAR_ON_EPISODE_START=true

# Drag recording and gripper safety.
CAPTURE_CONTROL_MODE=drag
# This rig's physical right leader is wired to the driver's left FTDI slot
# (DU0E1ZZP), so right-arm-only capture must cross-map it to the right follower.
RIGHT_ARM_SWAP_TELEOP_ACTIONS=true
DRAG_ACTION_STATE_MAX_AGE_MS=500
GRIPPER_MIN_POSITION=100
GRIPPER_MAX_POSITION=1000
GRIPPER_TORQUE_LIMIT=60

# Per-episode reset is deliberately disabled by default. Enabling it commands
# only the right arm to the target below before drag mode starts; the left arm
# receives no reset command. Clear the workspace before changing this to true.
EPISODE_RIGHT_ARM_RESET_ENABLED=false
EPISODE_RIGHT_ARM_HOME_JOINTS_DEG=0.251,-0.385,5.442,90.016,0.627,89.769,0.167
EPISODE_RIGHT_ARM_RESET_JOINTS_DEG=0.251,-0.385,5.442,90.016,0.627,89.769,0.167
EPISODE_RIGHT_ARM_RESET_SPEED=10
EPISODE_RIGHT_ARM_RESET_TOLERANCE_DEG=0.5
EPISODE_RIGHT_ARM_RESET_MAX_START_DELTA_DEG=45
EPISODE_RIGHT_ARM_RESET_TIMEOUT_S=45

# Dynamic single-arm return: the first pedal snapshots the live right follower
# pose; finish/discard returns to it. Disabled in the template because enabling
# it commands real motion after every episode.
EPISODE_RETURN_TO_START_ENABLED=false
RIGHT_ARM_EPISODE_RETURN_TO_START_ENABLED=true
EPISODE_RETURN_TO_START_SPEED=5
EPISODE_RETURN_TO_START_TOLERANCE_DEG=0.5
EPISODE_RETURN_TO_START_MAX_DELTA_DEG=60
EPISODE_RETURN_TO_START_TIMEOUT_S=60
EPISODE_RETURN_TO_START_POLL_HZ=20
EPISODE_RETURN_TO_START_STABLE_SAMPLES=3
EPISODE_RETURN_TO_START_SETTLE_S=0.5
EPISODE_RETURN_TO_START_QUERY_CONTROLLER_LIMITS=false
EPISODE_RETURN_TO_START_PAUSE_READERS=true
EPISODE_RETURN_TO_START_RESTORE_GRIPPER=false
EPISODE_RETURN_TO_START_GRIPPER_SPEED=30
EPISODE_RETURN_TO_START_GRIPPER_TOLERANCE=25
EPISODE_RETURN_TO_START_GRIPPER_TIMEOUT_S=10

# Let the connected leader gripper control the right follower while READY.
READY_GRIPPER_FOLLOW_ENABLED=true
READY_GRIPPER_FOLLOW_HZ=30
READY_GRIPPER_TAKEOVER_TOLERANCE=75
READY_GRIPPER_PAUSE_SETTLE_S=0.10
